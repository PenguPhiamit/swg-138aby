index 4e4a50f..fa337ec 100644
--- a/MMOCoreORB/src/server/zone/managers/botpop/BotPopManager.h
+++ b/MMOCoreORB/src/server/zone/managers/botpop/BotPopManager.h
@@ -291,6 +291,28 @@ private:
 	static float floorNear(Zone* zone, float x, float y, float referenceZ, float stepUp = 1.5f);
 	// How far up a step of `length` metres may climb: about a 30-degree ramp, at least a kerb, never a storey.
 	static float stepUpFor(float length) { return Math::max(1.2f, Math::min(2.5f, 0.6f * length)); }
+
+	// A bot's own lane, -0.4 to 0.4 m, and spacing, fixed by its object ID. Bots that share a navmesh route walk side
+	// by side instead of inside each other, and queue at a terminal instead of standing on one spot. 0.4 m keeps the
+	// body clear of walls: the meshes keep 0.5 m from them (RecastSettings m_agentRadius).
+	static float laneOf(CreatureObject* bot) {
+		return ((int)(((uint64)bot->getObjectID() * 2654435761ULL >> 20) % 9) - 4) * 0.1f;
+	}
+
+	static float spacingOf(CreatureObject* bot, float step, int slots) {
+		return (float)(((uint64)bot->getObjectID() * 40503ULL >> 12) % slots) * step;
+	}
+
+	// `point` moved `lane` metres to the right of the line from `from` to it.
+	static Vector3 inLane(const Vector3& from, const Vector3& point, float lane) {
+		float sx = point.getX() - from.getX(), sy = point.getY() - from.getY();
+		float length = std::sqrt(sx * sx + sy * sy);
+
+		if (length < 0.01f)
+			return point;
+
+		return Vector3(point.getX() + sy / length * lane, point.getY() - sx / length * lane, point.getZ());
+	}
 	static bool stepToward(CreatureObject* bot, Zone* zone, float tx, float ty, float speed, float seconds, float stopAt);
 	int planRoute(Zone* zone, const Vector3& from, float gx, float gy, std::vector<Vector3>& out);
 	bool startRoute(BotState* state, CreatureObject* bot, Zone* zone, float gx, float gy, float speed);
@@ -554,10 +576,11 @@ private:
 
 	static void walk(BotState* state, CreatureObject* bot, Zone* zone, float seconds, uint64 now) {
 		Vector3 position = bot->getPosition();
-		float budget = state->speed * seconds, dx = 0, dy = 0;
+		float budget = state->speed * seconds, dx = 0, dy = 0, lane = laneOf(bot);
 
 		while (budget > 0.01f && state->next < state->path.size()) {
-			const Vector3& target = state->path[state->next];
+			// In the bot's lane from the second waypoint on (the first leg has no line to offset from).
+			const Vector3 target = state->next > 0 ? inLane(state->path[state->next - 1], state->path[state->next], lane) : state->path[state->next];
 			float tx = target.getX() - position.getX(), ty = target.getY() - position.getY();
 			float distance = std::sqrt(tx * tx + ty * ty);
 
