+// A search of POCKET_NODES polygons that runs out of mesh before it runs out of nodes: the piece `ref` lies on is
+// smaller than that and doesn't hold `other`. A town's own piece runs to thousands (1,391 polygons in Anchorhead, up to
+// 25,239); the cut-off pieces run 19's bots stood on had 2 to 207.
+static const constexpr int POCKET_NODES = 512;
+
+inline dtNavMeshQuery* pocketQuery() {
+	static thread_local dtNavMeshQuery* query = dtAllocNavMeshQuery();
+	return query;
+}
+
+inline bool meshCutOff(dtNavMeshQuery* probe, dtPolyRef ref, const float* pos, dtPolyRef other, const float* otherPos) {
+	dtPolyRef polys[POCKET_NODES];
+	int count = 0;
+	dtStatus status = probe->findPath(ref, other, pos, otherPos, &meshFilter(), polys, &count, POCKET_NODES);
+
+	return (status & DT_SUCCESS) && (status & DT_PARTIAL_RESULT) && !(status & DT_OUT_OF_NODES);
+}
+
+// True, with (ref, pos) moved, when `ref` is on such a pocket: to the nearest polygon within 15 m across and 4 m up or
+// down that is on a piece joined to more than POCKET_NODES polygons or to `other`, trying the 4 nearest other pieces.
+// Off-line replay of run 19's bot positions on its navmeshes (partial-routes.md): Bestine's launch centre is on 55
+// polygons 4 m from the town's mesh and Tyrena's on 85, 12 m away, and every route from either stopped at its edge.
+inline bool meshOutOfPocket(dtNavMeshQuery* probe, dtPolyRef& ref, float* pos, dtPolyRef other, const float* otherPos) {
+	if (!meshCutOff(probe, ref, pos, other, otherPos))
+		return false;
+
+	dtNodePool* pool = probe->getNodePool();
+	const float extents[3] = {15.f, 4.f, 15.f};
+	dtPolyRef near[128];
+	int n = 0;
+	probe->queryPolygons(pos, extents, &meshFilter(), near, &n, 128);
+
+	struct Candidate {
+		float distance;
+		dtPolyRef ref;
+		float pos[3];
+	};
+
+	std::vector<Candidate> candidates;
+
+	for (int i = 0; i < n; ++i) {
+		if (pool->findNode(near[i], 0) != nullptr) // on the pocket itself
+			continue;
+
+		Candidate candidate;
+		candidate.ref = near[i];
+
+		if (!(probe->closestPointOnPoly(near[i], pos, candidate.pos, nullptr) & DT_SUCCESS))
+			continue;
+
+		candidate.distance = dtVdistSqr(candidate.pos, pos);
+		candidates.push_back(candidate);
+	}
+
+	std::sort(candidates.begin(), candidates.end(), [](const Candidate& x, const Candidate& y) { return x.distance < y.distance; });
+
+	std::vector<dtPolyRef> tried; // the polygons of other pockets already probed
+	int probes = 0;
+
+	for (const auto& candidate : candidates) {
+		if (std::find(tried.begin(), tried.end(), candidate.ref) != tried.end())
+			continue;
+
+		if (++probes > 4)
+			break;
+
+		if (!meshCutOff(probe, candidate.ref, candidate.pos, other, otherPos)) {
+			ref = candidate.ref;
+			dtVcopy(pos, candidate.pos);
+			return true;
+		}
+
+		for (int i = 0; i < pool->getNodeCount(); ++i)
+			tried.push_back(pool->getNodeAtIdx(i + 1)->id);
+	}
+
+	return false;
+}
