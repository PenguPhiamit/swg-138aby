+// Out of a starport after landing, as a player leaves it: into the terminal hall along the building's own path graph
+// (tripWalk to the travel terminal, the way an onward trip goes from the pad), then out of the hall's front door toward
+// the town's mission terminal. Done on stepping outdoors from the hall, or given up after 3 minutes; an "exit" row
+// either way. Run 19 (partial-routes.md): the pad is a piece of 79 to 156 navmesh polygons 32 to 43 m from the town's
+// at 15 of the 18 starports bots landed at, every route from it stopped at the pad's edge, and 691 of the 723 bots that
+// came down on one were still within 100 m of it 10 minutes or more later.
+inline void BotPopManager::tripExit(BotState* state, CreatureObject* bot, Zone* zone, LaunchState* L, uint64 now, float seconds) {
+	if (bot->isInCombat()) {
+		fightBack(state, bot, now);
+		return;
+	}
+
+	ManagedReference<SceneObject*> parent = bot->getParent().get();
+	bool inCell = parent != nullptr && parent->isCellObject();
+
+	auto finish = [&](const char* how) {
+		if (strcmp(how, "out") != 0)
+			tripLeaveCell(bot, L); // given up inside: out by the door it came in, as a failed trip
+
+		JSONSerializationType row = launchRow("exit", bot, L);
+		row["how"] = how;
+		row["secs"] = (int)((now - L->exitSinceMs) / 1000);
+		row["z"] = (int)bot->getPositionZ();
+		SimLog::instance()->write(row);
+
+		L->exitTerminalID = 0;
+		L->tripPath.clear();
+		L->tripPathFor = L->tripBestFor = 0;
+		state->path.clear();
+		state->chase.clear();
+		state->chaseNext = 0;
+		state->mode = BotState::IDLE;
+	};
+
+	if (now - L->exitSinceMs > 180000) {
+		finish("timeout");
+		return;
+	}
+
+	if (!L->exitInHall) {
+		ManagedReference<SceneObject*> terminal = bot->getZoneServer()->getObject(L->exitTerminalID);
+
+		if (terminal == nullptr || terminal->getZone() != zone) {
+			finish("no terminal");
+			return;
+		}
+
+		int walked = inCell ? 1 : tripWalk(state, bot, zone, L, terminal, 3.f, seconds);
+
+		if (walked < 0) {
+			finish("no path into the hall");
+			return;
+		}
+
+		if (walked > 0) { // in the hall (or at its terminal): a new path, out of the front door
+			L->exitInHall = true;
+			L->tripPath.clear();
+			L->tripPathFor = L->tripBestFor = 0;
+		}
+
+		return;
+	}
+
+	if (!inCell) {
+		finish("out");
+		return;
+	}
+
+	ManagedReference<MissionTerminal*> outside = launchFindTerminal(bot, zone, L);
+
+	if (outside == nullptr) {
+		finish("no town terminal");
+		return;
+	}
+
+	if (tripWalk(state, bot, zone, L, outside.get(), 3.f, seconds) < 0)
+		finish("no way out");
 }
 
