+// `point` moved onto the nearest walkable navmesh point within 40 m when it lies in a navmesh, so a bot doesn't start
+// inside a building's footprint (getSpawnPointInArea can leave one there: its fallback, and its pull back inside the
+// radius); unchanged outside the meshes.
+inline void BotPopManager::snapToMesh(Zone* zone, Vector3& point) {
+	SortedVector<ManagedReference<NavArea*>> areas;
+	zone->getInRangeNavMeshes(point.getX(), point.getY(), &areas, true);
+
+	if (areas.size() == 0)
+		return;
+
+	NavArea* area = areas.get(0).get();
+	RecastNavMesh* mesh = area->getNavMesh();
+
+	if (mesh == nullptr)
+		return;
+
+	ReadLocker locker(area);
+	dtNavMesh* navMesh = mesh->getNavMesh();
+	dtNavMeshQuery* query = meshQuery();
+
+	if (navMesh == nullptr || query == nullptr || !(query->init(navMesh, MESH_NODES) & DT_SUCCESS))
+		return;
+
+	Vector3 ground(point.getX(), point.getY(), floorNear(zone, point.getX(), point.getY(), std::nanf("")));
+	dtPolyRef ref;
+	float nearest[3];
+
+	if (meshNearest(query, ground, 10.f, 2.5f, ref, nearest) || meshNearest(query, ground, 40.f, 4.f, ref, nearest))
+		point = Vector3(nearest[0], -nearest[2], floorNear(zone, nearest[0], -nearest[2], std::nanf("")));
+}
