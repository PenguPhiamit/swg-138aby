+// BotPop's own Detour query on one navmesh, one per worker thread (PathFinderManager's is protected). Core3's
+// getRecastPath looks only 3 m north-south for the nearest polygon (extents {8, 8, 3}: Recast's x, height, z), takes
+// partial paths, and findPathFromWorldToWorld turns every failure into the straight line from start to end
+// (PathFinderManager.cpp:461-465): in a town, a bot running through whole buildings (owner, run 15, Coronet).
+static const constexpr int MESH_NODES = 8192; // Core3: 4096 (MAX_QUERY_NODES)
+static const constexpr int MESH_POLYS = 2048; // as Core3 (getRecastPath MAX_POLYS)
+static const constexpr int MESH_POINTS = 256;
+enum { MESH_OK = 0, MESH_PARTIAL = 1, MESH_NO_START = -1, MESH_NO_END = -2, MESH_NO_PATH = -3, MESH_NO_MESH = -4 };
+
+inline dtNavMeshQuery* meshQuery() {
+	static thread_local dtNavMeshQuery* query = dtAllocNavMeshQuery();
+	return query;
+}
+
+inline const dtQueryFilter& meshFilter() {
+	static const dtQueryFilter filter = [] {
+		dtQueryFilter f;
+		f.setIncludeFlags(SAMPLE_POLYFLAGS_ALL ^ (SAMPLE_POLYFLAGS_DISABLED | SAMPLE_POLYFLAGS_SWIM));
+		f.setExcludeFlags(0);
+		return f;
+	}();
+
+	return filter;
+}
+
+// The nearest polygon to p (world x, y, z) within `reach` m across and `rise` m up or down, and the point on it.
+inline bool meshNearest(dtNavMeshQuery* query, const Vector3& p, float reach, float rise, dtPolyRef& ref, float* nearest) {
+	const float centre[3] = {p.getX(), p.getZ(), -p.getY()};
+	const float extents[3] = {reach, rise, reach};
+	ref = 0;
+
+	return (query->findNearestPoly(centre, extents, &meshFilter(), &ref, nearest) & DT_SUCCESS) && ref != 0;
+}
+
+// The navmesh path from a to b on `area`, appended to `out` without a. MESH_OK, or MESH_PARTIAL when b can't be reached
+// (`out` then ends at the reachable point nearest it), or a failure with `out` unchanged. A start off the mesh (a bot
+// left in a building's footprint) is taken from the nearest polygon within 10 m, the hop to it first in `out`; an end
+// within 10 m, then 40 m (a town centre inside a building). 2.5 m up or down: the street, not a roof above it.
+inline int BotPopManager::meshPath(NavArea* area, const Vector3& a, const Vector3& b, std::vector<Vector3>& out) {
+	RecastNavMesh* mesh = area->getNavMesh();
+
+	if (mesh == nullptr) {
+		++legNoMesh;
+		return MESH_NO_MESH;
+	}
+
+	ReadLocker locker(area);
+	dtNavMesh* navMesh = mesh->getNavMesh();
+	dtNavMeshQuery* query = meshQuery();
+
+	if (navMesh == nullptr || query == nullptr || !(query->init(navMesh, MESH_NODES) & DT_SUCCESS)) {
+		++legNoMesh;
+		return MESH_NO_MESH;
+	}
+
+	dtPolyRef startRef, endRef;
+	float startPos[3], endPos[3];
+
+	if (!meshNearest(query, a, 10.f, 2.5f, startRef, startPos)) {
+		++legNoStart;
+		return MESH_NO_START;
+	}
+
+	if (!meshNearest(query, b, 10.f, 2.5f, endRef, endPos) && !meshNearest(query, b, 40.f, 4.f, endRef, endPos)) {
+		++legNoEnd;
+		return MESH_NO_END;
+	}
+
+	float hopX = startPos[0] - a.getX(), hopY = -startPos[2] - a.getY();
+	float endX = endPos[0] - b.getX(), endY = -endPos[2] - b.getY();
+	bool hop = hopX * hopX + hopY * hopY > 0.25f;
+
+	if (hop || endX * endX + endY * endY > 2.25f)
+		++legSnapped;
+
+	dtPolyRef polys[MESH_POLYS];
+	int count = 0;
+	dtStatus status = query->findPath(startRef, endRef, startPos, endPos, &meshFilter(), polys, &count, MESH_POLYS);
+
+	if (!(status & DT_SUCCESS) || count == 0) {
+		++legNoPath;
+		return MESH_NO_PATH;
+	}
+
+	bool partial = (status & DT_PARTIAL_RESULT) || polys[count - 1] != endRef;
+
+	if (partial) { // out of nodes, or b on a part of the mesh this one doesn't join: as near as it gets
+		++legPartial;
+		query->closestPointOnPoly(polys[count - 1], endPos, endPos, nullptr);
+	}
+
+	float points[MESH_POINTS * 3];
+	int n = 0;
+
+	if (!(query->findStraightPath(startPos, endPos, polys, count, points, nullptr, nullptr, &n, MESH_POINTS, 0) & DT_SUCCESS) || n == 0) {
+		++legNoPath;
+		return MESH_NO_PATH;
+	}
+
+	for (int i = hop ? 0 : 1; i < n; ++i)
+		out.push_back(Vector3(points[i * 3], -points[i * 3 + 2], points[i * 3 + 1]));
+
+	return partial ? MESH_PARTIAL : MESH_OK;
+}
