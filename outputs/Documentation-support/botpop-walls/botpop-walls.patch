+// The route from `from` to (gx, gy), round the buildings and walls of a city at either end, into `out` (the points
+// after `from`, the goal last). PathFinderManager::findPath looks for navmeshes only at a leg's midpoint
+// (findPathFromWorldToWorld), so a long leg out of a city or into one finds none and comes back as the straight line;
+// here each end that lies in a navmesh gets its own leg, between that end and the mesh's edge, and the open ground
+// between stays straight. Returns 1 for a navmesh route, 0 for the straight line (no navmesh at either end: two area
+// lookups, nothing else), -1 when this pass's ROUTES_PER_PASS are spent (`out` empty: try again next step).
+inline int BotPopManager::planRoute(Zone* zone, const Vector3& from, float gx, float gy, std::vector<Vector3>& out) {
+	out.clear();
+
+	SortedVector<ManagedReference<NavArea*>> atStart, atGoal;
+	zone->getInRangeNavMeshes(from.getX(), from.getY(), &atStart, true);
+	zone->getInRangeNavMeshes(gx, gy, &atGoal, true);
+
+	Vector3 goal(gx, gy, floorNear(zone, gx, gy, std::nanf("")));
+
+	if (atStart.size() == 0 && atGoal.size() == 0) {
+		out.push_back(goal);
+		return 0;
+	}
+
+	if (routeBudget.fetch_sub(1) <= 0) {
+		++routesDeferred;
+		return -1;
+	}
+
+	++routesPlanned;
+
+	// findPath from a to b, without a (the world -> world path is world points only).
+	auto leg = [&](const Vector3& a, const Vector3& b) {
+		WorldCoordinates start(a, nullptr);
+		WorldCoordinates end(b, nullptr);
+		std::unique_ptr<Vector<WorldCoordinates>> route(PathFinderManager::instance()->findPath(start, end, zone));
+
+		if (route == nullptr || route->size() < 2) {
+			out.push_back(b);
+			return;
+		}
+
+		for (int i = 1; i < route->size(); ++i) {
+			const WorldCoordinates& point = route->get(i);
+
+			if (point.getCell() == nullptr)
+				out.push_back(Vector3(point.getX(), point.getY(), point.getZ()));
+		}
+	};
+
+	// The last point of the line inside->outside that is still in the area, 2 m back inside (12 halvings: within 2 m
+	// on the longest legs), so findPath finds the mesh at the midpoint of its leg.
+	auto edge = [&](NavArea* area, const Vector3& inside, const Vector3& outside) {
+		float lo = 0, hi = 1, dx = outside.getX() - inside.getX(), dy = outside.getY() - inside.getY();
+
+		for (int i = 0; i < 12; ++i) {
+			float mid = (lo + hi) * 0.5f;
+
+			if (area->containsPoint(inside.getX() + dx * mid, inside.getY() + dy * mid))
+				lo = mid;
+			else
+				hi = mid;
+		}
+
+		float length = std::sqrt(dx * dx + dy * dy);
+		float t = length > 0.01f ? Math::max(0.f, lo - 2.f / length) : 0.f;
+		float x = inside.getX() + dx * t, y = inside.getY() + dy * t;
+
+		return Vector3(x, y, floorNear(zone, x, y, std::nanf("")));
+	};
+
+	for (int i = 0; i < atStart.size(); ++i) {
+		if (atStart.get(i)->containsPoint(gx, gy)) { // both ends in one city: the midpoint is in it too
+			leg(from, goal);
+			return 1;
+		}
+	}
+
+	Vector3 position = from;
+
+	if (atStart.size() > 0) {
+		Vector3 exit = edge(atStart.get(0).get(), from, goal);
+		leg(from, exit);
+		position = exit;
+	}
+
+	if (atGoal.size() > 0) {
+		Vector3 entry = edge(atGoal.get(0).get(), goal, position);
+		out.push_back(entry);
+		leg(entry, goal);
+	} else {
+		out.push_back(goal);
+	}
+
+	return 1;
+}
+
+// A walk to (gx, gy) along planRoute; false (and still not walking) when this pass's routes are spent.
+inline bool BotPopManager::startRoute(BotState* state, CreatureObject* bot, Zone* zone, float gx, float gy, float speed) {
+	if (planRoute(zone, bot->getPosition(), gx, gy, state->path) < 0)
+		return false;
+
+	state->next = 0;
+	state->mode = BotState::WALKING;
+	state->speed = speed;
+
+	return true;
+}
+
+// stepToward round the buildings: the same contract (true once within stopAt of the target), along a planRoute route
+// that is planned again only when the target has moved 4 m or a quarter of the distance (AiAgent re-plans a follow at
+// 4 m: findNextPosition), and at most every 2 s unless it jumped 30 m. Away from the navmeshes the route is the
+// straight line and this is stepToward plus two area lookups every 2 s.
+inline bool BotPopManager::chaseToward(BotState* state, CreatureObject* bot, Zone* zone, float tx, float ty, float speed, float seconds, float stopAt) {
+	Vector3 position = bot->getPosition();
+	float dx = tx - position.getX(), dy = ty - position.getY();
+	float distance = std::sqrt(dx * dx + dy * dy);
+
+	if (distance > stopAt) {
+		float mx = tx - state->chaseX, my = ty - state->chaseY;
+		float moved = std::sqrt(mx * mx + my * my);
+		bool stale = state->chaseNext >= state->chase.size() || moved > Math::max(4.f, distance * 0.25f);
+
+		if (stale && (state->lastStepMs >= state->chasePlannedMs + 2000 || moved > 30.f)) {
+			if (planRoute(zone, position, tx, ty, state->chase) < 1)
+				state->chase.clear(); // straight, or over budget: straight this time
+
+			state->chaseNext = 0;
+			state->chaseX = tx;
+			state->chaseY = ty;
+			state->chasePlannedMs = state->lastStepMs;
+		}
+
+		// Each waypoint but the last; the last is the target itself, wherever it is now.
+		while (state->chaseNext + 1 < state->chase.size()) {
+			const Vector3& point = state->chase[state->chaseNext];
+			float px = point.getX() - position.getX(), py = point.getY() - position.getY();
+
+			if (px * px + py * py > 1.f) {
+				stepToward(bot, zone, point.getX(), point.getY(), speed, seconds, 0.f);
+				return false;
+			}
+
+			++state->chaseNext;
+		}
+	}
+
+	return stepToward(bot, zone, tx, ty, speed, seconds, stopAt);
+}
