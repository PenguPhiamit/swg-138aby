+#ifndef BOTPOPGROUPS_H_
+#define BOTPOPGROUPS_H_
+
+/*
+ * Sandbox, test galaxy only (Claude, 17 Oct 2026; owner, 17 Oct: "in the old days we would do faction missions and join
+ * large groups to get better missions ... are they working together like the game needs?"). Stage 1 of
+ * outputs/Documentation-support/botpop-social/README.md.
+ *
+ * Hunters who reach their city's mission terminal while others wait there form a group of 2 to Core3.BotPopGroupMax, the
+ * way players do: the one who has waited longest invites (the stock /invite) and the others accept (/join). The leader
+ * then takes a destroy mission, which Core3 makes at the group's level, and the members follow it, take on what it
+ * fights, and shoot its lair with it. After Core3.BotPopGroupMissions missions the leader disbands the group.
+ *
+ * Locks. Every change to a Core3 group goes through the stock commands (invite, join, disband, leavegroup) on the bot's
+ * own command queue, so GroupManager runs with exactly the locks it takes for a player. A step never locks a group or
+ * another creature. It reads its own bot's group fields (isGrouped, getGroupInviterID) under the bot's lock, other
+ * bots' positions unlocked (as the medics' patient search does), and the plans in BotPopManager under launchShared,
+ * which a step takes after its bot's lock and never holds while locking anything else.
+ */
+namespace botpop {
+
+inline int BotPopManager::groupShare() {
+	static const int share = Math::max(0, Math::min(100, configInt("Core3.BotPopGroups", 0)));
+	return share;
+}
+
+// The group's level as Core3 works it out (GroupObject::calculateGroupLevel): the highest member's level plus a fifth
+// of each other member's. From the members' combat levels in the plan (Core3 reads CreatureObject::getLevel; the
+// mission_take row's core_lvl is what it actually used).
+inline int BotPopManager::launchGroupLevel(LaunchState* L, int own) {
+	std::vector<int> levels;
+
+	{
+		Locker locker(&launchShared);
+		auto it = groupPlans.find(L->groupLeaderID);
+
+		if (it != groupPlans.end()) {
+			for (const auto& member : it->second.members)
+				levels.push_back(member.second.level);
+		}
+	}
+
+	if (levels.empty())
+		return own;
+
+	std::sort(levels.begin(), levels.end(), std::greater<int>());
+	float level = levels[0];
+
+	for (size_t i = 1; i < levels.size(); ++i)
+		level += levels[i] / 5.f;
+
+	return (int)std::round(level);
+}
+
+// gid (the leader), grole and gsize on a row, for a bot in a group.
+inline void BotPopManager::launchGroupFields(JSONSerializationType& row, LaunchState* L) {
+	if (L->groupRole != LaunchState::GROUP_LEADER && L->groupRole != LaunchState::GROUP_MEMBER)
+		return;
+
+	int size = 0;
+
+	{
+		Locker locker(&launchShared);
+		auto it = groupPlans.find(L->groupLeaderID);
+
+		if (it != groupPlans.end())
+			size = (int)it->second.members.size();
+	}
+
+	row["gid"] = L->groupLeaderID;
+	row["grole"] = L->groupRole == LaunchState::GROUP_LEADER ? "leader" : "member";
+	row["gsize"] = size;
+}
+
+// At the terminal, before the mission list. True while the bot is busy with a group here (waiting, inviting, or
+// waiting for its invites to be answered); false when it should go on and take a mission (alone, or as a leader whose
+// group is in).
+inline bool BotPopManager::launchGroupAtTerminal(CreatureObject* bot, LaunchState* L, SceneObject* terminal, uint64 now) {
+	if (!L->wantsGroup || now < L->nextGroupTryMs || terminal == nullptr)
+		return false;
+
+	static const int maxSize = Math::max(2, Math::min(5, configInt("Core3.BotPopGroupMax", 5)));
+	static const uint64 waitMs = 1000ULL * Math::max(20, configInt("Core3.BotPopGroupWait", 90));
+	uint64 me = bot->getObjectID();
+
+	if (L->groupRole == LaunchState::GROUP_LEADER) {
+		if (L->groupReady)
+			return false; // the group's next mission
+
+		size_t joined = 0, invited = 0;
+		bool found = false;
+
+		{
+			Locker locker(&launchShared);
+			auto it = groupPlans.find(me);
+
+			if (it != groupPlans.end()) {
+				found = true;
+				joined = it->second.members.size(); // the leader too, once grouped
+				invited = it->second.invited.size();
+			}
+		}
+
+		if (!found) {
+			launchGroupEnd(bot, L, "plan gone", now);
+			return false;
+		}
+
+		// Everyone in, or a minute gone: go with whoever came. Nobody: alone after all.
+		if (joined < invited + 1 && now - L->groupSinceMs < 60000)
+			return true;
+
+		if (!bot->isGrouped()) {
+			launchGroupEnd(bot, L, "nobody joined", now);
+			return false;
+		}
+
+		L->groupReady = true;
+
+		JSONSerializationType row = launchRow("group_ready", bot, L);
+		row["invited"] = (int)invited;
+		row["joined"] = (int)joined - 1;
+		row["secs"] = (int)((now - L->groupSinceMs) / 1000);
+		row["glvl"] = launchGroupLevel(L, combatLevel(bot));
+		launchGroupFields(row, L);
+		SimLog::instance()->write(row);
+		return false;
+	}
+
+	if (L->groupRole == LaunchState::GROUP_MEMBER)
+		return false; // launchGroupFollow has its step; nothing to do here
+
+	int level = combatLevel(bot);
+	std::vector<uint64> invite;
+	std::vector<int> levels;
+	int seekers = 0;
+	bool alone = false;
+
+	{
+		Locker locker(&launchShared);
+
+		// Picked by a leader here: wait for its invite (launchGroupFollow accepts it).
+		auto picked = groupMemberOf.find(me);
+
+		if (picked != groupMemberOf.end()) {
+			L->groupRole = LaunchState::GROUP_MEMBER;
+			L->groupLeaderID = picked->second;
+			L->groupSinceMs = now;
+			L->groupJoined = false;
+			return true;
+		}
+
+		uint64 terminalID = terminal->getObjectID();
+		std::vector<GroupSeeker>& queue = groupSeeking[terminalID];
+
+		// Seekers gone for more than twice the wait (logged out, travelled, fighting far away) leave the queue.
+		for (size_t i = 0; i < queue.size();) {
+			if (queue[i].bot != me && now - queue[i].sinceMs > 2 * waitMs)
+				queue.erase(queue.begin() + i);
+			else
+				++i;
+		}
+
+		size_t self = queue.size();
+
+		for (size_t i = 0; i < queue.size(); ++i) {
+			if (queue[i].bot == me)
+				self = i;
+		}
+
+		if (self == queue.size()) {
+			queue.push_back({me, now, level});
+			L->groupRole = LaunchState::GROUP_SEEKING;
+			L->groupTerminalID = terminalID;
+			L->groupSinceMs = now;
+		}
+
+		seekers = (int)queue.size();
+
+		// The one who came first leads: when the group would be full, or after a third of the wait with anyone else
+		// here within 10 levels of it (players group across levels, but not a level 2 with a level 20).
+		if (self == 0 && queue.size() >= 2 && (queue.size() >= (size_t)maxSize || now - L->groupSinceMs >= waitMs / 3)) {
+			for (size_t i = 1; i < queue.size() && (int)invite.size() < maxSize - 1;) {
+				if (std::abs(queue[i].level - level) <= 10) {
+					invite.push_back(queue[i].bot);
+					levels.push_back(queue[i].level);
+					groupMemberOf[queue[i].bot] = me;
+					queue.erase(queue.begin() + i);
+				} else {
+					++i;
+				}
+			}
+
+			if (!invite.empty()) {
+				queue.erase(queue.begin());
+
+				GroupPlan& plan = groupPlans[me];
+				plan = GroupPlan();
+				plan.terminalID = terminalID;
+				plan.formedMs = now;
+				plan.invited = invite;
+			}
+		}
+
+		if (invite.empty() && now - L->groupSinceMs > waitMs) {
+			for (size_t i = 0; i < queue.size(); ++i) {
+				if (queue[i].bot == me) {
+					queue.erase(queue.begin() + i);
+					break;
+				}
+			}
+
+			alone = true;
+		}
+	}
+
+	if (alone) {
+		JSONSerializationType row = launchRow("group_alone", bot, L);
+		row["secs"] = (int)((now - L->groupSinceMs) / 1000);
+		row["seekers"] = seekers;
+		row["lvl"] = level;
+		SimLog::instance()->write(row);
+
+		L->groupRole = LaunchState::GROUP_NONE;
+		L->nextGroupTryMs = now + 1800000;
+		return false;
+	}
+
+	if (invite.empty())
+		return true; // waiting here for others
+
+	// Leader: one /invite each, as a player types them.
+	for (uint64 id : invite)
+		bot->enqueueCommand(STRING_HASHCODE("invite"), 0, id, "");
+
+	L->groupRole = LaunchState::GROUP_LEADER;
+	L->groupLeaderID = me;
+	L->groupSinceMs = now;
+	L->groupReady = false;
+	++launchGroups;
+
+	JSONSerializationType row = launchRow("group_form", bot, L);
+	row["invited"] = (int)invite.size();
+	row["lvl"] = level;
+	row["lvls"] = levels;
+	row["seekers"] = seekers;
+	row["gid"] = me;
+	SimLog::instance()->write(row);
+	return true;
+}
+
+// A member's step, when there is no target, corpse or rest: accept the invite, then the leader's lair, the leader's
+// target, or the leader's heels. False when the bot is out of the group and plays on alone.
+inline bool BotPopManager::launchGroupFollow(BotState* state, CreatureObject* bot, Zone* zone, LaunchState* L, uint64 now, float seconds) {
+	GroupPlan plan;
+	bool found = false;
+
+	{
+		Locker locker(&launchShared);
+		auto it = groupPlans.find(L->groupLeaderID);
+
+		if (it != groupPlans.end()) {
+			plan = it->second;
+			found = true;
+		}
+	}
+
+	if (!found) {
+		launchGroupEnd(bot, L, "plan gone", now);
+		return false;
+	}
+
+	if (!bot->isGrouped()) {
+		if (L->groupJoined) {
+			launchGroupEnd(bot, L, "group broke up", now);
+			return false;
+		}
+
+		if (now - L->groupSinceMs > 60000) {
+			launchGroupEnd(bot, L, "never joined", now);
+			return false;
+		}
+
+		// The invite has reached us: accept it (the stock /join runs GroupManager::joinGroup with no locks held).
+		if (bot->getGroupInviterID() == L->groupLeaderID && now >= L->nextGroupCommandMs) {
+			bot->enqueueCommand(STRING_HASHCODE("join"), 0, 0, "");
+			L->nextGroupCommandMs = now + 5000;
+		}
+
+		return true; // waiting at the terminal
+	}
+
+	if (!L->groupJoined) {
+		L->groupJoined = true;
+		L->groupTakenSeen = plan.taken;
+		L->groupDoneSeen = plan.done;
+		L->groupBankBefore = bot->getBankCredits();
+		L->groupSpentBefore = L->bankSpent;
+
+		JSONSerializationType row = launchRow("group_join", bot, L);
+		row["secs"] = (int)((now - L->groupSinceMs) / 1000);
+		row["lvl"] = combatLevel(bot);
+		launchGroupFields(row, L);
+		SimLog::instance()->write(row);
+	}
+
+	// The leader's mission paid out: what reached this member's bank (Core3 pays members within 128 m of the lair).
+	if (plan.done != L->groupDoneSeen) {
+		JSONSerializationType row = launchRow("group_share", bot, L);
+		row["paid"] = bot->getBankCredits() - L->groupBankBefore + (L->bankSpent - L->groupSpentBefore);
+		row["reward"] = plan.reward;
+		row["mlvl"] = plan.mlvl;
+		int dx = (int)(bot->getPositionX() - plan.missionX), dy = (int)(bot->getPositionY() - plan.missionY);
+		row["dist"] = (int)std::sqrt((float)(dx * dx + dy * dy));
+		launchGroupFields(row, L);
+		SimLog::instance()->write(row);
+
+		L->groupDoneSeen = plan.done;
+	}
+
+	if (plan.taken != L->groupTakenSeen) { // a new mission: count its payout from here
+		L->groupTakenSeen = plan.taken;
+		L->groupBankBefore = bot->getBankCredits();
+		L->groupSpentBefore = L->bankSpent;
+	}
+
+	ZoneServer* zoneServer = bot->getZoneServer();
+
+	// The leader's lair. lairID also tells launchHunt not to drop combat with it (the "atLair" check).
+	ManagedReference<SceneObject*> lair;
+
+	if (plan.lairID != 0)
+		lair = zoneServer->getObject(plan.lairID);
+
+	if (lair != nullptr && lair->getZone() == zone && lair->isLairObject()) {
+		L->lairID = plan.lairID;
+		ManagedReference<WeaponObject*> weapon = bot->getWeapon();
+		float reach = weapon != nullptr && weapon->isRangedWeapon() ? 6.f : 4.f; // as launchMission
+
+		if (state->mode == BotState::WALKING) {
+			state->path.clear();
+			state->mode = BotState::IDLE;
+		}
+
+		if (chaseToward(state, bot, zone, lair->getPositionX(), lair->getPositionY(), 5.5f, seconds, reach) && now >= L->nextAttackMs) {
+			bot->setTargetID(plan.lairID, false);
+			bot->enqueueCommand(STRING_HASHCODE("attack"), 0, plan.lairID, "");
+			L->nextAttackMs = now + 2000;
+		}
+
+		return true;
+	}
+
+	L->lairID = 0;
+
+	// What the leader is fighting, if it is near.
+	if (plan.targetID != 0 && L->skip.count(plan.targetID) == 0) {
+		ManagedReference<SceneObject*> object = zoneServer->getObject(plan.targetID);
+
+		if (object != nullptr && object->isAiAgent() && !object->asAiAgent()->isDead() && object->getZone() == zone && object->getDistanceTo(bot) < 80.f) {
+			launchAdopt(L, object->asAiAgent(), now);
+
+			if (state->mode == BotState::WALKING) {
+				state->path.clear();
+				state->mode = BotState::IDLE;
+			}
+
+			return true;
+		}
+	}
+
+	// Otherwise at the leader's heels, a few metres apart.
+	ManagedReference<SceneObject*> leader = zoneServer->getObject(L->groupLeaderID);
+
+	if (leader == nullptr || leader->getZone() != zone) {
+		launchGroupEnd(bot, L, "leader gone", now);
+		return false;
+	}
+
+	float dx = leader->getPositionX() - bot->getPositionX(), dy = leader->getPositionY() - bot->getPositionY();
+
+	if (dx * dx + dy * dy > 12.f * 12.f) {
+		if (state->mode == BotState::WALKING) {
+			state->path.clear();
+			state->mode = BotState::IDLE;
+		}
+
+		chaseToward(state, bot, zone, leader->getPositionX(), leader->getPositionY(), 5.5f, seconds, 6.f + spacingOf(bot, 1.f, 4));
+	}
+
+	return true;
+}
+
+// Every step of a grouped bot (end of launchStep): its own entry in the plan, and for the leader the group's mission,
+// lair and target; then the leader's reasons to break the group up.
+inline void BotPopManager::launchGroupPublish(CreatureObject* bot, LaunchState* L, uint64 now) {
+	if (L->groupRole != LaunchState::GROUP_LEADER && L->groupRole != LaunchState::GROUP_MEMBER)
+		return;
+
+	bool leader = L->groupRole == LaunchState::GROUP_LEADER;
+
+	if (!bot->isGrouped()) {
+		// The leader's group broke up under it (its members left); a member's case is launchGroupFollow's.
+		if (leader && L->groupReady)
+			launchGroupEnd(bot, L, "group broke up", now);
+
+		return;
+	}
+
+	static const int missionsWanted = Math::max(1, configInt("Core3.BotPopGroupMissions", 3));
+	uint64 me = bot->getObjectID();
+	GroupMember entry = {combatLevel(bot), bot->getPositionX(), bot->getPositionY()};
+	int done = 0;
+	bool found = false;
+
+	{
+		Locker locker(&launchShared);
+		auto it = groupPlans.find(L->groupLeaderID);
+
+		if (it != groupPlans.end()) {
+			found = true;
+			GroupPlan& plan = it->second;
+			plan.members[me] = entry;
+
+			if (leader) {
+				if (L->missionID != 0 && plan.missionID != L->missionID) {
+					++plan.taken;
+					plan.reward = L->missionReward;
+					plan.mlvl = L->missionLevel;
+				}
+
+				plan.missionID = L->missionID;
+				plan.lairID = L->lairID;
+				plan.targetID = L->targetID;
+				plan.missionX = L->missionX;
+				plan.missionY = L->missionY;
+				done = plan.done;
+			}
+		}
+	}
+
+	if (!found || !leader || L->missionID != 0)
+		return;
+
+	if (done >= missionsWanted)
+		launchGroupEnd(bot, L, "missions done", now);
+	else if (now - L->groupSinceMs > 2700000)
+		launchGroupEnd(bot, L, "45 minutes", now);
+}
+
+// The leader's mission left its datapad (launchMission's mission_done or mission_gone). Returns how many members were
+// within 128 m of the mission spot by their last steps.
+inline int BotPopManager::launchGroupMissionDone(LaunchState* L, bool paid) {
+	int near = 0;
+
+	Locker locker(&launchShared);
+	auto it = groupPlans.find(L->groupLeaderID);
+
+	if (it == groupPlans.end())
+		return 0;
+
+	GroupPlan& plan = it->second;
+
+	for (const auto& member : plan.members) {
+		float dx = member.second.x - L->missionX, dy = member.second.y - L->missionY;
+
+		if (dx * dx + dy * dy < 128.f * 128.f)
+			++near;
+	}
+
+	if (paid) {
+		++plan.done;
+		++launchGroupMissions;
+	}
+
+	plan.missionID = plan.lairID = 0;
+	return near;
+}
+
+// Out of the group (or the queue at the terminal): the leader disbands it, a member leaves it, both with the stock
+// command; the shared plan goes with the leader.
+inline void BotPopManager::launchGroupEnd(CreatureObject* bot, LaunchState* L, const char* reason, uint64 now) {
+	uint64 me = bot->getObjectID();
+	bool leader = L->groupRole == LaunchState::GROUP_LEADER;
+	int size = 0, done = 0;
+
+	{
+		Locker locker(&launchShared);
+
+		if (leader) {
+			auto it = groupPlans.find(me);
+
+			if (it != groupPlans.end()) {
+				size = (int)it->second.members.size();
+				done = it->second.done;
+
+				for (uint64 id : it->second.invited) {
+					auto member = groupMemberOf.find(id);
+
+					if (member != groupMemberOf.end() && member->second == me)
+						groupMemberOf.erase(member);
+				}
+
+				groupPlans.erase(it);
+			}
+		} else if (L->groupRole == LaunchState::GROUP_MEMBER) {
+			auto member = groupMemberOf.find(me);
+
+			if (member != groupMemberOf.end() && member->second == L->groupLeaderID)
+				groupMemberOf.erase(member);
+
+			auto it = groupPlans.find(L->groupLeaderID);
+
+			if (it != groupPlans.end()) {
+				size = (int)it->second.members.size();
+				done = it->second.done;
+				it->second.members.erase(me);
+			}
+		}
+
+		auto queue = groupSeeking.find(L->groupTerminalID);
+
+		if (queue != groupSeeking.end()) {
+			for (size_t i = 0; i < queue->second.size(); ++i) {
+				if (queue->second[i].bot == me) {
+					queue->second.erase(queue->second.begin() + i);
+					break;
+				}
+			}
+		}
+	}
+
+	if (bot->isGrouped())
+		bot->enqueueCommand(leader ? STRING_HASHCODE("disband") : STRING_HASHCODE("leavegroup"), 0, 0, "");
+
+	if (L->groupRole != LaunchState::GROUP_SEEKING) {
+		JSONSerializationType row = launchRow("group_end", bot, L);
+		row["grole"] = leader ? "leader" : "member";
+		row["gid"] = L->groupLeaderID;
+		row["reason"] = reason;
+		row["gsize"] = size;
+		row["done"] = done;
+		row["mins"] = (int)((now - L->groupSinceMs) / 60000);
+		SimLog::instance()->write(row);
+	}
+
+	if (L->groupRole == LaunchState::GROUP_MEMBER && L->missionID == 0)
+		L->lairID = 0; // the leader's lair, not ours
+
+	L->groupRole = LaunchState::GROUP_NONE;
+	L->groupLeaderID = 0;
+	L->groupReady = L->groupJoined = false;
+	L->nextGroupTryMs = now + 600000;
+}
+
+// A bot logged out (BotPopManager::logOut, no creature locked): out of every shared group map. Its members find the
+// plan gone at their next step and leave the Core3 group, which PlayerObject::unload already took the bot out of.
+inline void BotPopManager::launchGroupForget(uint64 botID) {
+	Locker locker(&launchShared);
+
+	auto it = groupPlans.find(botID);
+
+	if (it != groupPlans.end()) {
+		for (uint64 id : it->second.invited) {
+			auto member = groupMemberOf.find(id);
+
+			if (member != groupMemberOf.end() && member->second == botID)
+				groupMemberOf.erase(member);
+		}
+
+		groupPlans.erase(it);
+	}
+
+	auto member = groupMemberOf.find(botID);
+
+	if (member != groupMemberOf.end()) {
+		auto plan = groupPlans.find(member->second);
+
+		if (plan != groupPlans.end())
+			plan->second.members.erase(botID);
+
+		groupMemberOf.erase(member);
+	}
+
+	for (auto& queue : groupSeeking) {
+		for (size_t i = 0; i < queue.second.size(); ++i) {
+			if (queue.second[i].bot == botID) {
+				queue.second.erase(queue.second.begin() + i);
+				break;
+			}
+		}
+	}
+}
