+// The highest template level among a lair template's regular mobiles (0 if unknown). Lair and herd creatures spawn at
+// their template level whatever the row's difficulty; boss mobiles come only once the lair is attacked.
+static int highestLairCreatureLevel(uint32 lairHashCode) {
+	CreatureTemplateManager* templateManager = CreatureTemplateManager::instance();
+	LairTemplate* lairTemplate = templateManager->getLairTemplate(lairHashCode);
+
+	if (lairTemplate == nullptr)
+		return 0;
+
+	const VectorMap<String, int>* mobiles = lairTemplate->getMobiles();
+	int highest = 0;
+
+	for (int i = 0; i < mobiles->size(); ++i) {
+		CreatureTemplate* creatureTemplate = templateManager->getTemplate(mobiles->elementAt(i).getKey());
+
+		if (creatureTemplate != nullptr)
+			highest = Math::max(highest, creatureTemplate->getLevel());
+	}
+
+	return highest;
+}
