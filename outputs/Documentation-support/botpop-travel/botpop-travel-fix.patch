+// The fare from planet `from` to planet `to` in the travel table (datatables/travel/travel.iff, what purchaseTicket
+// charges and the purchase window lists); 0: no route.
+inline int BotPopManager::tripFareBetween(ZoneServer* zoneServer, const String& from, const String& to) {
+	Zone* zone = zoneServer->getZone(from);
+	return zone != nullptr ? zone->getPlanetManager()->getTravelFare(from, to) : 0;
+}
+
+// A city on a loaded planet with a fare from `from` and a fare on to `to` (a hub, such as Corellia between Tatooine
+// and Talus): the starting cities of such planets, else their outposts, one at random. False when there is none.
+inline bool BotPopManager::tripHub(ZoneServer* zoneServer, const String& from, const String& to, City& out) {
+	std::vector<City> starters, outposts;
+
+	auto consider = [&](const City& city, std::vector<City>& list) {
+		if (from == city.planet || to == city.planet || zoneServer->getZone(city.planet) == nullptr)
+			return;
+
+		if (tripFareBetween(zoneServer, from, city.planet) > 0 && tripFareBetween(zoneServer, city.planet, to) > 0)
+			list.push_back(city);
+	};
+
+	for (int i = 0; i < STARTER_CITY_COUNT; ++i)
+		consider(STARTER_CITIES[i], starters);
+
+	for (int i = 0; i < DESTINATION_COUNT; ++i)
+		consider(DESTINATIONS[i].city, outposts);
+
+	consider(HUTTA_CITY, outposts);
+
+	std::vector<City>& list = starters.empty() ? outposts : starters;
+
+	if (list.empty())
+		return false;
+
+	out = list[System::random(list.size() - 1)];
+	return true;
+}
