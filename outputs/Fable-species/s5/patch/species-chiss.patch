+
+bool PlayerCreationManager::canWearRace(const Vector<uint32>* races, const String& raceFile) const {
+	if (races == nullptr)
+		return false;
+
+	if (races->contains(raceFile.hashCode()))
+		return true;
+
+	if (humanRigRaces.contains(raceFile))
+		return races->contains(humanRigRaces.get(raceFile).hashCode());
+
+	return false;
+}
