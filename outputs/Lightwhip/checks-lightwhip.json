 "strings": {
  "string/en/weapon_name.stf": {
   "sword_lightwhip": "Lightwhip"
  },
  "string/en/weapon_detail.stf": {
   "sword_lightwhip": "A rare cousin of the lightsaber. Several small crystals feed a long, flexible strand of energy instead of a rigid blade, giving the wielder a reach few duelists know how to answer. It is hard to master, poor at blocking, and weaker against heavy armor than a true blade."
  },
