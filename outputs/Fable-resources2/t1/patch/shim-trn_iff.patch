-        self.pos += struct.calcsize(fmt)
-        return v
-
-    def i32(self):
-        return self._take('<i')
-
-    def u32(self):
-        return self._take('<I')
-
-    def f32(self):
-        return self._take('<f')
-
-    def u8(self):
-        return self._take('<B')
-
-    def cstr(self):
-        """Zero-terminated string (Core3 Chunk::readString reads bytes up to the first NUL)."""
