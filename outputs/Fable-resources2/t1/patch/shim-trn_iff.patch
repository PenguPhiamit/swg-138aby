-def list_tre(archive_path):
-    """{lower name: (offset, size, comp, comp_size)} for one .tre archive. Our own reader of the TRE index:
-    36-byte header 'EERT' + version + 7 ints (record count, record-block offset, its compression and stored size,
-    name-block compression, stored size and unpacked size); the name block follows the record block; records are
-    24 bytes (crc, size, offset, compression, compressed size, name offset). Compression 2 is zlib."""
-    import zlib
-    if archive_path in _tre_cache:
-        return _tre_cache[archive_path]
-    entries = {}
-    with open(archive_path, 'rb') as f:
-        head = f.read(36)
-        if head[:4] != b'EERT':
-            raise ValueError(f'{archive_path}: not a TRE archive')
-        count, info_off, info_comp, info_size_c, name_comp, name_size_c, name_size_u = struct.unpack_from('<7I', head, 8)
-        f.seek(info_off)
-        info = f.read(info_size_c)
-        if info_comp == 2:
-            info = zlib.decompress(info)
-        names = f.read(name_size_c)
-        if name_comp == 2:
-            names = zlib.decompress(names)
-    for i in range(count):
-        crc, size, offset, comp, comp_size, name_off = struct.unpack_from('<IIIIII', info, i * 24)
-        end = names.index(b'\0', name_off)
-        entries[names[name_off:end].decode('latin-1').lower()] = (offset, size, comp, comp_size)
-    _tre_cache[archive_path] = entries
-    return entries
