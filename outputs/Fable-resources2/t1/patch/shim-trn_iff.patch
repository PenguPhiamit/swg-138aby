-def parse(buf, start=0, end=None):
-    """Parse the records between start and end into a list of Nodes."""
-    end = len(buf) if end is None else end
-    nodes = []
-    i = start
-    while i + 8 <= end:
-        tag = buf[i:i + 4].decode('latin-1')
-        size = struct.unpack_from('>I', buf, i + 4)[0]
-        body_start, body_end = i + 8, i + 8 + size
-        if body_end > end:
-            raise ValueError(f'record {tag} at {i} runs past its parent ({body_end} > {end})')
-        if tag == 'FORM':
-            ftype = buf[body_start:body_start + 4].decode('latin-1')
-            nodes.append(Node('FORM', ftype, children=parse(buf, body_start + 4, body_end)))
-        else:
-            nodes.append(Node(tag, data=bytes(buf[body_start:body_end])))
-        i = body_end
-    if i != end:
-        raise ValueError(f'{end - i} trailing bytes that are not a record')
-    return nodes
