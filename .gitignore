# Local history for the SWG project (owner, 14 Oct 2026: "do the local history for now"). No remote yet.
# Keep this list push-safe even though nothing is pushed: no secrets, no game files, no other people's downloads,
# nothing huge. After adding a folder, check `git status --ignored` before committing. Names: AGENTS.md, Privacy.
# Pushes go only through outputs/tools/github_export.py, which filters the history (AGENTS.md).

# ---- secrets and private settings (AGENTS.md, Privacy) ----
outputs/SWG-login.txt
**/config-local.lua
**/agent-account.json
**/*.key
**/*.pem
**/*webhook*
**/.claude/settings.local.json
# The LAN address of a friend's Ollama server (outputs/tools/agents/local/REMOTE-OLLAMA.md): private
outputs/tools/agents/local/ollama-url.txt
# Which model and context size this PC's scripts ask for (per machine, not shared)
outputs/tools/agents/local/ollama-model.txt
outputs/tools/agents/local/ollama-ctx.txt

# ---- the game client, archives, backups and other people's files ----
outputs/SWG-client/
outputs/Community-content/
outputs/Backups/
*.tre
*.toc
*.iff
*.trn
*.stf
*.dds
*.msh
*.mgn
*.sht
*.apt
*.lod
*.pob
*.skt
*.ans
*.snd
*.wav
*.mp3
*.zip
*.pdf
outputs/Documentation-support/hoth/client-base/
outputs/Local-content/local_planets/
tmp/
# work/: 13 Oct scratch. Only its scripts are kept. It also holds third-party clones (work/research), Python packages,
# client cfg copies and chat journals. The SWG-Source clones were removed on 15 Oct (fingerprints: work/excluded-fingerprints/).
work/*
!work/*.py
*.cfg

# ---- screenshots and images from the game ----
*.png
*.jpg

# ---- big generated inventories (rebuild them with their tools) ----
outputs/Content-catalogue/published-source-paths.json
outputs/Content-catalogue/A2-checkout-sha256.json
outputs/Content-catalogue/MTG-file-inventory.json
outputs/Documentation-support/storyteller/client-inventory.json
outputs/Documentation-support/storyteller/identity-metadata.json
outputs/Fable-backport/work/
outputs/Fable-backport/staged/
outputs/Fable-backport/staged-batch2/

# ---- churn: logs, live status, per-run bot reports ----
*.log
*.err
*.pyc
__pycache__/
outputs/Agent/logs/
outputs/Agent/live/
outputs/Bot-reports/*/*.json
outputs/Bot-reports/runs/*.json
outputs/Bot-reports/runs/STOP
outputs/Bot-reports/runs/ACTIVE
outputs/Bot-reports/gate/*.txt
outputs/Bot-reports/gate/*.log
outputs/Bot-reports/gate/RUNNING

# ---- records of and scripts for the excluded SWG-Source material (AGENTS.md, Source and rights) ----
outputs/Content-catalogue/Cut-content-and-backports/
work/audit_backport_candidates.py
work/prepare_cut_content_selection.py

# ---- client UI files (stock-derived, e.g. Fable's staged ui_avatardata.inc); our own .ws/.tga stay tracked ----
*.inc

# Retained source-page evidence; original archives are already ignored.
outputs/Farming-assets/*/source.html
*.7z

# Class-check data: regenerate with python -I outputs/Claude-class-check/build_matrix.py (about 35 s)
outputs/Claude-class-check/commands.json
outputs/Claude-class-check/professions.json
outputs/MTG-merges/shadow-audit.json
outputs/MTG-merges/work/
outputs/tools/.owner-email

# Local-model research workspaces: line-numbered copies of Core3 source and raw agent logs stay local
outputs/Agent/local-research/*/src/
outputs/Agent/local-research/*/agent-log.jsonl
outputs/Agent/local-research/.lock
outputs/Agent/local-research/*.tmp
outputs/Agent/local-research/state.json
# chunk jobs (local_jobs.py / local_map.py): inputs and raw answers stay local; report.md and map-output.txt are kept
outputs/Agent/local-research/*/input.jsonl
outputs/Agent/local-research/*/instruction.txt
outputs/Agent/local-research/*/lines.json
outputs/Agent/local-research/*/results.jsonl
outputs/Agent/local-research/*/errors.jsonl
# live_map.py temporary movement logs (48 h, rotated)
outputs/Bot-reports/tracker/
# escort.py play data (combat near the player, for Creature Handler work)
outputs/Bot-reports/play/
# Input listener (owner's own keys and clicks while logged in, 48 h) and its config with the owner's character names
outputs/Agent/listener/
outputs/tools/listener/listener-config.json
# navmap.py floor plans (derived from the client files)
outputs/Bot-reports/navmaps/
